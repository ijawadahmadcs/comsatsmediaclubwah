# Copy to .env.local for local development, and set the same variables in Vercel.
# Missing or invalid values are listed in the server log at startup (lib/env.ts).

# MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=

# Signs the admin and Team Lead session cookie. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Cloudinary account that stores all photos and videos (Console > Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Cloudflare Turnstile CAPTCHA on the join form. Set both, or leave both empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only read by `npm run seed:admin`, which creates the superadmin or resets its password.
# The password must be 12-72 characters with no leading or trailing spaces.
INITIAL_ADMIN_REGISTRATION_NUMBER=
INITIAL_ADMIN_PASSWORD=
